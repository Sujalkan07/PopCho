{
  "name": "popcho-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "node --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "test:security": "node --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs src/tests/auth-security.test.ts",
    "test:search": "node --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs src/tests/phase2-search-verify.test.ts",
    "test:e2e": "node --dns-result-order=ipv4first ./node_modules/tsx/dist/cli.mjs src/tests/phase3-e2e-integration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
