# PopCho Server Environment Variables
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/popcho
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# TMDB Server Credentials (SERVER-SIDE ONLY)
# Precedence: TMDB_READ_ACCESS_TOKEN is preferred over TMDB_API_KEY.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
