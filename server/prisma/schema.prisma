
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Community {
  id          String       @id @default(cuid())
  tmdbId      Int
  mediaType   String
  title       String
  slug        String       @unique
  description String?      @db.Text
  posterPath  String?
  backdropPath String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships Membership[]
  channels    Channel[]

  @@unique([tmdbId, mediaType])
  @@index([title])
}

model Membership {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())

  community  Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model Channel {
  id          String    @id @default(cuid())
  communityId String
  name        String
  slug        String
  description String?
  type        String    @default("TEXT")
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([communityId, slug])
  @@index([communityId])
}

model Message {
  id        String     @id @default(cuid())
  channelId String
  userId    String
  content   String     @db.Text
  isSpoiler Boolean    @default(false)
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  channel   Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent    Message?   @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[]  @relation("MessageReplies")
  reactions Reaction[]

  @@index([channelId, createdAt])
  @@index([userId])
  @@index([parentId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model Review {
  id           String          @id @default(cuid())
  tmdbId       Int
  mediaType    String          @default("tv")
  showTitle    String
  showPoster   String?
  showBackdrop String?
  headline     String
  content      String          @db.Text
  rating       Float           @default(5.0)
  essayType    String          @default("Comprehensive Analysis")
  categoryTag  String          @default("Review")
  hasSpoiler   Boolean         @default(false)
  userId       String
  userName     String
  userAvatar   String?
  userRole     String?         @default("Community Critic")
  helpfulCount Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  votes        ReviewVote[]
  comments     ReviewComment[]
  bookmarks    ReviewBookmark[]

  @@index([tmdbId, mediaType])
  @@index([userId])
  @@index([createdAt])
  @@index([helpfulCount])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model ReviewComment {
  id         String   @id @default(cuid())
  reviewId   String
  userId     String
  userName   String
  userAvatar String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
}

model ReviewBookmark {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

model Profile {
  id          String   @id // Supabase user ID (UUID)
  email       String?
  displayName String?
  username    String?
  avatarUrl   String?
  role        String?  @default("Community Member")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([username])
}

model Watchlist {
  id         String   @id @default(cuid())
  userId     String   // Supabase user ID
  tmdbId     Int
  mediaType  String   // 'movie' | 'tv'
  title      String
  posterPath String?
  createdAt  DateTime @default(now())

  @@unique([userId, tmdbId, mediaType])
  @@index([userId])
}
