# ==============================================================================
# PopCho Environment Configuration Example
# Copy this file to .env (or server/.env) and fill in the values.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / Browser-safe)
# ------------------------------------------------------------------------------
# In local development: can be left empty to use Vite's proxy (/api -> http://localhost:5000)
# In production (e.g., Vercel): set to your deployed backend origin (e.g. https://popcho-backend.onrender.com)
# CRITICAL RULE: NEVER put TMDB API keys or tokens in frontend/Vite variables.
VITE_API_URL=http://localhost:5000

# Supabase Auth & Database (Frontend / Public Anon Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Server-only / Secrets)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/popcho
JWT_SECRET=replace_with_a_secure_random_secret_in_production

# ------------------------------------------------------------------------------
# TMDB CREDENTIALS (SERVER-SIDE ONLY)
# Precedence & Supported Credential Types:
#   1. TMDB_READ_ACCESS_TOKEN (v4 Read Access Token) - PREFERRED
#      Used via Authorization: Bearer <token>
#   2. TMDB_API_KEY (v3 API Key) - FALLBACK
#      Used via api_key query parameter
# If both are provided, TMDB_READ_ACCESS_TOKEN takes precedence.
# Neither credential will ever be sent to or exposed in the frontend.
# ------------------------------------------------------------------------------
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
